# Copy this file to .env and fill in real values.
# .env is gitignored — .env.example is the shareable template, never put real secrets in it.

# --- Polymarket wallet ---
# Private key of the wallet used to sign CLOB orders (0x-prefixed or not, either works).
# Read by order_executor.py / preflight_check.py via --private-key-env (default name below).
POLYMARKET_PRIVATE_KEY=0xyour_private_key_here

# Only needed if you trade through a Polymarket proxy wallet (--signature-type 1 or 2)
# instead of a plain EOA wallet. Leave blank for the default --signature-type 0.
POLYMARKET_FUNDER=

# --- Telegram (oracle_lag_strategy.py hourly summaries) ---
# Create a bot via @BotFather in Telegram, message it once, then check
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
