# secrets
.env
!.env.example

# createwallet/*.txt is where create_polygon_wallet.py's --save-plaintext
# option writes raw private keys/mnemonics — never commit these
createwallet/*.txt
createwallet/*keystore*.json

*.pem
*.key

# paper_trading/ runtime state — generated locally, not source
paper_trading/paper_state.json
paper_trading/paper_state.tmp
